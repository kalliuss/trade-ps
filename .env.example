# Bu dosyayı ".env" adıyla kopyala ve değerleri doldur. ".env" asla commit edilmez.
# EXPO_PUBLIC_ ile başlayan değişkenler uygulama paketine gömülür, yani herkese açıktır.
# Buraya SADECE publishable (anon) key yazılır. Secret / service_role key ASLA yazılmaz.

# Supabase paneli > Project Settings > Data API (veya Connect) > Project URL
EXPO_PUBLIC_SUPABASE_URL=

# Supabase paneli > Project Settings > API Keys > Publishable key (sb_publishable_...)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
